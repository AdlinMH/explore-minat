# Salin ke .env.local untuk pengembangan lokal. Jangan commit .env.local.
# Di Vercel, isi lewat Project Settings → Environment Variables, lalu redeploy.
# Tidak ada variabel rahasia yang memakai prefix NEXT_PUBLIC_.

# Supabase Postgres (server-only). Dashboard Supabase → Connect → "Transaction pooler"
# (port 6543), contoh bentuk: postgresql://postgres.<project-ref>:<password>@<host>:6543/postgres
DATABASE_URL=

# Hash PIN admin 6 digit. Buat dengan: npm run hash-pin  (PIN diketik tersembunyi).
# Format: scrypt:N:r:p:salt:hash. Mengganti nilai ini mencabut semua sesi admin.
ADMIN_PIN_HASH=
# Opsional: ubah nilai apa pun untuk mencabut semua sesi admin tanpa mengganti PIN.
ADMIN_SESSION_EPOCH=

# Opsional: origin tambahan yang diizinkan untuk mutasi (pisahkan dengan koma), mis. domain kustom.
APP_ORIGIN=
# Opsional di luar Vercel: set 1 hanya jika berada di belakang proxy tepercaya yang menulis X-Forwarded-For.
TRUST_PROXY=
